{
  "name": "first-draft-axi",
  "version": "0.1.0",
  "description": "AXI CLI that turns a prompt into design mocks: self-contained HTML pages, made by the model you choose through BYOKit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/first-draft.git"
  },
  "type": "module",
  "bin": {
    "first-draft-axi": "src/cli.mjs"
  },
  "files": [
    "src",
    "skills",
    "dist",
    "ENGINE.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@byokit/accounts": "0.28.1",
    "@byokit/decide": "0.12.1",
    "@byokit/secrets": "0.5.2",
    "@earendil-works/pi-ai": "^1.3.0",
    "@mariozechner/pi-agent-core": "0.72.1",
    "@mariozechner/pi-ai": "0.72.1",
    "@mariozechner/pi-coding-agent": "0.72.1",
    "@sinclair/typebox": "0.34.49",
    "yaml": "2.9.0",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
